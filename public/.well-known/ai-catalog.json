    {
      "identifier": "urn:air:x402tap.com:api:microtap",
      "displayName": "MicroTap API",
      "type": "application/vnd.oai.openapi+json",
      "url": "https://x402tap.com/openapi.json",
      "description": "20 monetized HTTP APIs on the x402 protocol — prediction markets (Polymarket, Kalshi, plus a cross-platform divergence/arbitrage finder), DeFi/crypto data, multi-chain on-chain reads, live weather, and real-time web search. No API keys or signups: call any route, receive an HTTP 402 with the exact USDC price, sign a payment, retry, and get the data back. Payments settle on Base or Solana mainnet through Coinbase's CDP Facilitator.",
      "tags": [
        "x402",
        "payments",
        "api",
        "prediction-markets",
        "polymarket",
        "kalshi",
        "arbitrage",
        "defi",
        "crypto",
        "on-chain",
        "blockchain",
        "weather",
        "web-search"
      ],
      "capabilities": [
        "getProtected",
        "getWeather",
        "getGenerate",
        "getInsights",
        "getPing",
        "getPolymarketMarkets",
        "getPolymarketMarket",
        "getKalshiMarkets",
        "getKalshiMarket",
        "getDefiTvl",
        "getDefiChains",
        "getCryptoPrice",
        "getCryptoMarket",
        "getCryptoTrending",
        "getWebSearch",
        "getPredictionArb",
        "getRpc",
        "getWalletBalance",
        "getGasPrice",
        "getEnsResolve"
      ],
      "representativeQueries": [
        "what's the weather in Austin right now",
        "find Polymarket markets about the election",
        "what's Uniswap's current TVL",
        "what's the current gas price on Base",
        "resolve vitalik.eth to an address",
        "find the biggest odds divergence between Polymarket and Kalshi right now"
      ],
