        "paymentNetworks": ["eip155:8453 (Base mainnet)", "Solana mainnet"],
        "paymentCurrency": "USDC",
        "priceRangeUsd": "0.001-0.05",
        "facilitator": "Coinbase CDP Facilitator",
        "authRequired": false
